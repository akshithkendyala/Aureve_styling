# ==========================================
# AUREVÉ Environment Configuration
# ==========================================

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Security
# Generate a strong 32+ character random string for signing user sessions
JWT_SECRET=aureve_super_secret_jwt_encryption_key_2026_luxury_wardrobe_stylist

# Supabase (PostgreSQL Database & Secure Storage)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Vision & Reasoning Engine
# Google Gemini API key (Used for instant clothing detection & intelligent outfit reasoning)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Weather API (Open-Meteo is used by default with zero API key requirement, but you can configure external providers)
WEATHER_API_PROVIDER=open-meteo
